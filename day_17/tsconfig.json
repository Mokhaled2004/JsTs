{
    "compilerOptions": {
      "module": "commonjs",
      "declaration": true,
      "removeComments": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "allowSyntheticDefaultImports": true,
      "esModuleInterop": true,
      "target": "esnext",
      "sourceMap": true,
      "outDir": "./dist",
      "baseUrl": "./",
      "sourceRoot": "./src",
      "incremental": true,
      "moduleResolution": "node",
      "skipLibCheck": true,
      "typeRoots": ["./node_modules/@types", "./src/@types"],
      "types": ["node"]
    },
    "exclude": ["node_modules", "dist"]
  }
  